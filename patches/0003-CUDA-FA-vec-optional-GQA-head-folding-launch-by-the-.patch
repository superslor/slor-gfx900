+// How many Q heads of one GQA group to fold into a single block. 1 disables folding.
+// Only powers of two are instantiated, and the group must divide the head count so that
+// blockIdx.z tiles evenly (launch_fattn computes ntiles_z_gqa = gqa_ratio/ncols2).
+static int ggml_cuda_fattn_vec_gqa_fold(const int gqa_ratio, const int ne02, const float max_bias, const int D, const int64_t nkv) {
+    if (max_bias != 0.0f) {
+        return 1; // per-head ALiBi slopes cannot share a block
+    }
+    // The fold pays only once the KV cache is long: measured on a P100 (2026-10-20, head 256,
+    // GQA 6, one query) the folded kernel costs 243 vs 151 us at 4096 keys and 391 vs 276 at 8192,
+    // breaks even at 16384 (532 vs 531), and wins at 32768 (820 vs 1052) and 65536 (1503 vs 2141).
+    // Below the crossover use the unfolded ladder. GGML_CUDA_FA_VEC_GQA_MINKV overrides.
+    static const int64_t min_kv = [] { const char * s = getenv("GGML_CUDA_FA_VEC_GQA_MINKV"); return s ? atoll(s) : (int64_t) 16384; }();
+    if (nkv < min_kv) {
+        return 1;
+    }
+
+    // Not restricted to powers of two: the common GQA ratio here is 6, and folding only 4 of it
+    // would leave most of the redundant K/V traffic in place. Every value listed is instantiated.
+    static const int supported[] = {8, 6, 4, 3, 2};
+
+    int ncols2_max = 8;
+    if (const char * s = getenv("GGML_CUDA_FA_VEC_GQA")) {
+        ncols2_max = atoi(s);
+        if (ncols2_max < 1) {
+            return 1;
+        }
+    }
+
+    for (const int c : supported) {
+        if (c <= ncols2_max && gqa_ratio % c == 0 && ne02 % c == 0) {
+            return c;
+        }
+    }
+    return 1;
+    GGML_UNUSED(D);
+}
