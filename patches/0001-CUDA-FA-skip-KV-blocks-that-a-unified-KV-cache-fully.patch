@@ -1088,6 +1186,34 @@ void launch_fattn(
     const int ntiles_z_gqa = ((gqa_ratio + ncols2 - 1) / ncols2);
     const int ntiles_dst   = ntiles_x * ntiles_z_gqa * K->ne[2] * Q->ne[3];
 
+    // Bitmap of the KV blocks that contain any non-masked value. KV_max below only trims
+    // fully-masked blocks off the TAIL; with a unified KV cache the sequences share one cell
+    // pool, so a sequence's own cells are interleaved with the other sequences' cells and the
+    // fully-masked blocks sit in the INTERIOR where the tail trim cannot reach them. Without
+    // this, every sequence pays for the total number of cells in use rather than its own.
+    // Restricted to kernels that walk the KV cache with blockIdx.y; the stream-k path
+    // distributes work differently and is not handled here.
+    if (mask && !stream_k && K->ne[1] % FATTN_KQ_STRIDE == 0 && K->ne[1] >= FATTN_KV_BITS_MIN_KV) {
+        const int iter_k_bits = K->ne[1] / FATTN_KQ_STRIDE;
+
+        if (iter_k_bits > 1 && iter_k_bits <= FATTN_MAX_KV_BLOCKS) {
+            const int64_t s31 = mask->nb[1] / sizeof(half2);
+            const int64_t s33 = mask->nb[3] / sizeof(half2);
+
+            const dim3 blocks_num_bits(ntiles_x, Q->ne[3], 1);
+            const dim3 block_dim_bits(FATTN_BLOCKS_NTHREADS, 1, 1);
+
+            const int nwords = (iter_k_bits + 31) / 32;
+
+            KV_blocks.alloc(size_t(blocks_num_bits.x) * blocks_num_bits.y * nwords);
+            ggml_cuda_kernel_launch_params launch_params_bits =
+                ggml_cuda_kernel_launch_params(blocks_num_bits, block_dim_bits, 0, main_stream);
+            ggml_cuda_kernel_launch(flash_attn_mask_to_KV_bits<ncols1>, launch_params_bits,
+                (const half2 *) mask->data, KV_blocks.ptr, iter_k_bits, s31, s33, (int) mask->ne[1]);
+            CUDA_CHECK(cudaGetLastError());
+        }
+    }
+
     // Optional optimization where the mask is scanned to determine whether part of the calculation can be skipped.
     // Only worth the overhead if there is at lease one FATTN_KQ_STRIDE x FATTN_KQ_STRIDE square to be skipped or
     //     multiple sequences of possibly different lengths.
@@ -1215,6 +1341,7 @@ void launch_fattn(
         mask ? ((const char *) mask->data) : nullptr,
         sinks ? ((const char *) sinks->data) : nullptr,
         KV_max.ptr,
+        KV_blocks.ptr,
         !stream_k && parallel_blocks > 1 ? dst_tmp.ptr : (float *) KQV->data, dst_tmp_meta.ptr,
         scale, max_bias, m0, m1, n_head_log2, logit_softcap,
         Q->ne[0], ne01,     Q->ne[2], Q->ne[3], Q->nb[1], Q->nb[2], Q->nb[3],
