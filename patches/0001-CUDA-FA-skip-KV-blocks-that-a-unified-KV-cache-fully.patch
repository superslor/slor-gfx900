+// Maximum number of KV blocks (of FATTN_KQ_STRIDE each) for which a skip list is built.
+// 2048 blocks * FATTN_KQ_STRIDE == 512k context; beyond that fall back to the KV_max tail trim.
+#define FATTN_MAX_KV_BLOCKS 2048
+
+// Below this KV length the scan is not worth its own launch overhead.
+#define FATTN_KV_BITS_MIN_KV 4096
+
+// Build a BITMAP of the KV blocks that contain at least one non-masked value, one bit per
+// block of FATTN_KQ_STRIDE tokens, for each (sequence, j-tile). Layout per (sequence, jt):
+// nwords = ceil(ne30/32) consecutive words, bit kb%32 of word kb/32 set == block kb is live.
+//
+// flash_attn_mask_to_KV_max above only trims fully-masked blocks off the TAIL. With a unified
+// KV cache several sequences share one cell pool, so a sequence's own cells are interleaved
+// with other sequences' cells and the fully-masked blocks sit in the INTERIOR, where the tail
+// trim cannot reach them. Listing the blocks explicitly skips those too.
+//
+// Skipping in place rather than compacting is deliberate: a fully-masked block contributes
+// exactly 0 to both the softmax numerator and denominator and leaves the running maximum
+// untouched, so as long as each CUDA block still visits the remaining blocks in the same
+// order, dropping the fully-masked ones is bit-for-bit identical to processing them.
+#define FATTN_BLOCKS_NTHREADS 256
+
+template <int ncols1>
+__launch_bounds__(FATTN_BLOCKS_NTHREADS, 1)
+static __global__ void flash_attn_mask_to_KV_bits(
+        const half2 * mask_ptr, int * bits_ptr, const int ne30, const int64_t s31, const int64_t s33, const int nrows) {
+    const half2 * GGML_CUDA_RESTRICT mask = mask_ptr;
+    int         * GGML_CUDA_RESTRICT bits = bits_ptr;
+
+    constexpr int nwarps = FATTN_BLOCKS_NTHREADS / WARP_SIZE;
+
+    const int ntiles   = gridDim.x;
+    const int jt       = blockIdx.x;
+    const int sequence = blockIdx.y;
+    const int lane     = threadIdx.x % WARP_SIZE;
+    const int warp_id  = threadIdx.x / WARP_SIZE;
+    const int nwords   = (ne30 + 31) / 32;
+
+    mask += sequence*s33 + jt*ncols1*s31;
+
+    __shared__ int words[FATTN_MAX_KV_BLOCKS/32];
+
+    for (int i = threadIdx.x; i < nwords; i += FATTN_BLOCKS_NTHREADS) {
+        words[i] = 0;
+    }
+
+    ggml_cuda_pdl_sync();
+    __syncthreads();
+
+    // Each warp tests whole KV blocks independently; only the shared bitmap is contended.
+    for (int kb = warp_id; kb < ne30; kb += nwarps) {
+        int all_inf = 1;
+
+#pragma unroll
+        for (int j = 0; j < ncols1; ++j) {
+            // the mask has exactly nrows (= n_tokens) rows, not a multiple of ncols1.
+            // Reading the padding columns' rows went past the mask (one 512 KB row per missing column at kv=262144):
+            // harmless for the result (a stray row can only mark a block live) but an out-of-bounds read that
+            // faulted once nothing mapped followed the mask. Padding columns have no mask row; skip them.
+            if (jt*ncols1 + j >= nrows) {
+                break;
+            }
+            const half2 * row = mask + j*s31 + kb*(FATTN_KQ_STRIDE/2);
+
+            for (int i = lane; i < FATTN_KQ_STRIDE/2; i += WARP_SIZE) {
+                const float2 tmp = __half22float2(row[i]);
+                all_inf = all_inf && int(isinf(tmp.x)) && int(isinf(tmp.y));
+            }
+        }
+
+        all_inf = warp_reduce_all(all_inf);
+
+        if (lane == 0 && !all_inf) {
+            atomicOr(&words[kb / 32], 1 << (kb % 32));
+        }
+    }
+
+    __syncthreads();
+
+    int * out = bits + (sequence*ntiles + jt)*nwords;
+    for (int i = threadIdx.x; i < nwords; i += FATTN_BLOCKS_NTHREADS) {
+        out[i] = words[i];
+    }
+}
+
+// Is the KV block containing token k_VKQ_0 live for this (sequence, j-tile)?
+// KV_bits_row == nullptr means "no skip information available", i.e. treat every block as live.
+static __device__ __forceinline__ bool fattn_kv_block_live(
+        const int * __restrict__ KV_bits_row, const int k_VKQ_0) {
+    if (!KV_bits_row) {
+        return true;
+    }
+    const int kb = k_VKQ_0 / FATTN_KQ_STRIDE;
+    return (KV_bits_row[kb / 32] >> (kb % 32)) & 1;
+}
