+#include "mmvq-gcn.cuh"
+
+#if !defined(GGML_USE_HIP)
+bool ggml_cuda_mmvq_gcn_try(ggml_backend_cuda_context &, const ggml_tensor *, const ggml_tensor *, ggml_tensor *,
+                            const ggml_cuda_mm_fusion_args_host *) { return false; }
+#else
+#include "quantize.cuh"
+#include "unary.cuh"
+
+// the generic mmvq spends ~67 instructions per 8 q6_K weights on gfx900 (64-bit address math, a load
+// wait per vec_dot, a 128-thread reduction per 4096-wide row), so it is issue-bound at ~200 GB/s of the card's ~396.
+// Here one wave owns R rows; lane l always decodes the same 16 weights of a block (4 per scale group, from 3 dwords:
+// ql[l], ql[l+32], qh[l] as in dequantize_row_q6_K) and steps 4 blocks at a time, so its offsets stay fixed, the
+// q8_1 activations are loaded once for all R rows, and the row ends in one DPP wave reduction.
+
+static __device__ __forceinline__ int mmvq_gcn_ld32_a2(const char * p) { // q6_K blocks are 210 bytes: 2-byte aligned
+    const uint16_t * p16 = (const uint16_t *) p;
+    return p16[0] | (p16[1] << 16);
+}
+
+// ggml_cuda_dp4a(a, b, 0) without the accumulator: on gfx900 that one needs its c in a register (a v_mov per call)
+static __device__ __forceinline__ int mmvq_gcn_dp4a0(const int a, const int b) {
+#if defined(__gfx900__)
+    int r, t0, t1, t2;
+    asm("\n \
+        v_mul_i32_i24_sdwa %1, sext(%4), sext(%5) dst_sel:DWORD dst_unused:UNUSED_PAD src0_sel:BYTE_0 src1_sel:BYTE_0 \n \
+        v_mul_i32_i24_sdwa %2, sext(%4), sext(%5) dst_sel:DWORD dst_unused:UNUSED_PAD src0_sel:BYTE_1 src1_sel:BYTE_1 \n \
+        v_mul_i32_i24_sdwa %3, sext(%4), sext(%5) dst_sel:DWORD dst_unused:UNUSED_PAD src0_sel:BYTE_2 src1_sel:BYTE_2 \n \
+        v_add3_u32 %0, %1, %2, %3 \n \
+        v_mul_i32_i24_sdwa %1, sext(%4), sext(%5) dst_sel:DWORD dst_unused:UNUSED_PAD src0_sel:BYTE_3 src1_sel:BYTE_3 \n \
+        v_add_u32 %0, %0, %1 \n \
+        "
+        : "=&v"(r), "=&v"(t0), "=&v"(t1), "=&v"(t2)
+        : "v"(a), "v"(b)
+    );
+    return r;
+#else
+    return ggml_cuda_dp4a(a, b, 0);
+#endif // defined(__gfx900__)
+}
+
+// q - 32 per byte for q in 0..63: borrow-free, nothing to saturate
+static __device__ __forceinline__ int mmvq_gcn_sub32(const int q) {
+    return ((q | 0x80808080) - 0x20202020) ^ 0x80808080;
+}
+
+// One lane's raw share of a q6_K block (16 weights) and of the four q8_1 blocks they meet. (Loading these a step
+// ahead was no faster - at 200 W the card is power-bound, so what counts is instructions per weight - and took 2x VGPRs.)
+struct mmvq_gcn_q6_K_raw {
+    int ql0, ql1, qh, sc0, sc1;
+    int d;
+};
+
+template <int ncols>
+struct mmvq_gcn_q8_1_raw {
+    int qs[ncols][4];
+    int ds[ncols][4];
+};
+
+template <int ncols>
+static __device__ __forceinline__ void mmvq_gcn_q8_1_load(mmvq_gcn_q8_1_raw<ncols> & y, const block_q8_1 * yl,
+        const int stride_col_y, const int p) {
+#pragma unroll
+    for (int j = 0; j < ncols; ++j) {
+#pragma unroll
+        for (int g = 0; g < 4; ++g) {
+            const block_q8_1 * q = yl + j*stride_col_y + g;
+            y.qs[j][g] = ((const int *) q->qs)[p];
+            y.ds[j][g] = *(const int *) &q->ds;
+        }
+    }
+}
+
+template <int ncols>
+static __device__ __forceinline__ void mmvq_gcn_q6_K_dot(const mmvq_gcn_q6_K_raw & x, const mmvq_gcn_q8_1_raw<ncols> & y,
+        const int sh, float (&acc)[ncols]) {
+    const int w[4] = {
+        mmvq_gcn_sub32(( x.ql0       & 0x0F0F0F0F) | ((x.qh << 4) & 0x30303030)),   // j = l
+        mmvq_gcn_sub32(( x.ql1       & 0x0F0F0F0F) | ((x.qh << 2) & 0x30303030)),   // j = l + 32
+        mmvq_gcn_sub32(((x.ql0 >> 4) & 0x0F0F0F0F) | ( x.qh       & 0x30303030)),   // j = l + 64
+        mmvq_gcn_sub32(((x.ql1 >> 4) & 0x0F0F0F0F) | ((x.qh >> 2) & 0x30303030)),   // j = l + 96
+    };
+    const int s[4] = { (int8_t) (x.sc0 >> sh), (int8_t) (x.sc0 >> (sh + 16)), (int8_t) (x.sc1 >> sh), (int8_t) (x.sc1 >> (sh + 16)) };
+    const float d6 = __half2float(__ushort_as_half((unsigned short) x.d));
+
+#pragma unroll
+    for (int j = 0; j < ncols; ++j) {
+        float sum = 0.0f;
+#pragma unroll
+        for (int g = 0; g < 4; ++g) {
+            const float d8 = __half2float(__ushort_as_half((unsigned short) y.ds[j][g]));
+            sum += d8 * (float) __mul24(mmvq_gcn_dp4a0(w[g], y.qs[j][g]), s[g]); // |dot| <= 16256: 24-bit, full rate
+        }
+        acc[j] += d6 * sum;
+    }
+}
+
+template <int ncols, int R, bool has_gate>
+__launch_bounds__(256, 1)
+static __global__ void mmvq_gcn_q6_K(
+        const char * __restrict__ vx, const char * __restrict__ vgate, const block_q8_1 * __restrict__ y,
+        float * __restrict__ dst, const int nblk, const int nrows, const int64_t stride_row,
+        const int stride_col_y, const int stride_col_dst, const ggml_glu_op glu) {
+    constexpr int NR = has_gate ? 2*R : R;   // matrices x rows streamed per step
+
+    const int lane = threadIdx.x;
+    const int row0 = (blockIdx.x*4 + __builtin_amdgcn_readfirstlane(threadIdx.y)) * R;
+    if (row0 >= nrows) {
+        return;
+    }
+
+    const int hf = (lane >> 3) & 1;
+    const int p  = lane & 7;                 // weights l = 4p..4p+3 of the half
+    const int sh = 8*(p >> 2);               // scale l/16 within the half's 8
+
+    // lane owns blocks ib = lane/16 + 4*step; its fields sit at fixed offsets in each, so offsets just step 4 blocks
+    const uint32_t o_ql = hf*64 + 4*p;
+    const uint32_t o_qh = 128 + hf*32 + 4*p;
+    const uint32_t o_sc = 192 + hf*8;
+    uint32_t       o    = (lane >> 4)*210;
+    const block_q8_1 * yl = y + (lane >> 4)*8 + hf*4;   // its four q8_1 blocks (one per scale group), +32 per step
+
+    const char * xr[NR];
+#pragma unroll
+    for (int r = 0; r < R; ++r) {
+        const int row = min(row0 + r, nrows - 1);
+        xr[r] = vx + row*stride_row;
+        if constexpr (has_gate) {
+            xr[R + r] = vgate + row*stride_row;
+        }
+    }
+
+    auto load = [&](mmvq_gcn_q6_K_raw (&xw)[NR], mmvq_gcn_q8_1_raw<ncols> & yw) {
+#pragma unroll
+        for (int r = 0; r < NR; ++r) {
+            // one 32-bit offset onto the scalar row base: (o + o_ql) first, or it becomes two 64-bit adds
+            xw[r].ql0 = mmvq_gcn_ld32_a2(xr[r] + (o + o_ql));
+            xw[r].ql1 = mmvq_gcn_ld32_a2(xr[r] + (o + o_ql) + 32);
+            xw[r].qh  = mmvq_gcn_ld32_a2(xr[r] + (o + o_qh));
+            xw[r].sc0 = mmvq_gcn_ld32_a2(xr[r] + (o + o_sc));
+            xw[r].sc1 = mmvq_gcn_ld32_a2(xr[r] + (o + o_sc) + 4);
+            xw[r].d   = *(const uint16_t *) (xr[r] + (o + 208));
+        }
+        mmvq_gcn_q8_1_load<ncols>(yw, yl, stride_col_y, p);
+    };
+
+    float acc[NR][ncols] = {{0.0f}};
+
+    for (int ib = lane >> 4; ib < nblk; ib += 4) {
+        mmvq_gcn_q6_K_raw        xw[NR];
+        mmvq_gcn_q8_1_raw<ncols> yw;
+        load(xw, yw);
+#pragma unroll
+        for (int r = 0; r < NR; ++r) {
+            mmvq_gcn_q6_K_dot<ncols>(xw[r], yw, sh, acc[r]);
+        }
+        o  += 4*210;
+        yl += 4*8;
+    }
+
+#pragma unroll
+    for (int r = 0; r < R; ++r) {
+#pragma unroll
+        for (int j = 0; j < ncols; ++j) {
+            float v = warp_reduce_sum<64>(acc[r][j]);
+            if constexpr (has_gate) {
+                const float g = warp_reduce_sum<64>(acc[R + r][j]);
+                switch (glu) {
+                    case GGML_GLU_OP_SWIGLU: v *= ggml_cuda_op_silu_single(g); break;
+                    case GGML_GLU_OP_GEGLU:  v *= ggml_cuda_op_gelu_single(g); break;
+                    default:                 v *= g;                           break;
+                }
+            }
+            if (lane == 0 && row0 + r < nrows) {
+                dst[j*stride_col_dst + row0 + r] = v;
+            }
+        }
+    }
+}
+
+// Row pairs: rows a and b share one 32-bit multiplier per weight, (wa - 32) + 65536*(wb - 32), so one v_mul_i32_i24 by
+// an activation byte makes both rows' products. 8 of them sum to |lo| <= 8*32*127 < 2^15, and +0x8000 keeps the low
+// half from borrowing: WORD_0 - 0x8000 is row a's sum and WORD_1 row b's. A lane takes 8 weights of each of 2 scale
+// groups (l = 8p..8p+7 of quarters gp and gp + 2), so the scale, convert and FMA run once per 8 weights, not 4.
+// one load of a 2-byte aligned dword (two 16-bit loads that the compiler merges get split apart again with perms)
+typedef int mmvq_gcn_int_a2 __attribute__((aligned(2)));
+static __device__ __forceinline__ int mmvq_gcn_ld32_u(const char * p) {
+    return *(const mmvq_gcn_int_a2 *) p;
+}
+
+template <int c>
+static __device__ __forceinline__ int mmvq_gcn_mul_pair_byte(const int pw, const int y) {
+    int r;
+    if constexpr (c == 0) {
+        asm("v_mul_i32_i24_sdwa %0, %1, sext(%2) dst_sel:DWORD dst_unused:UNUSED_PAD src0_sel:DWORD src1_sel:BYTE_0" : "=v"(r) : "v"(pw), "v"(y));
+    } else if constexpr (c == 1) {
+        asm("v_mul_i32_i24_sdwa %0, %1, sext(%2) dst_sel:DWORD dst_unused:UNUSED_PAD src0_sel:DWORD src1_sel:BYTE_1" : "=v"(r) : "v"(pw), "v"(y));
+    } else if constexpr (c == 2) {
+        asm("v_mul_i32_i24_sdwa %0, %1, sext(%2) dst_sel:DWORD dst_unused:UNUSED_PAD src0_sel:DWORD src1_sel:BYTE_2" : "=v"(r) : "v"(pw), "v"(y));
+    } else {
+        asm("v_mul_i32_i24_sdwa %0, %1, sext(%2) dst_sel:DWORD dst_unused:UNUSED_PAD src0_sel:DWORD src1_sel:BYTE_3" : "=v"(r) : "v"(pw), "v"(y));
+    }
+    return r;
+}
+
+static __device__ __forceinline__ int mmvq_gcn_mul_word0(const int r, const int s) { // zext(r & 0xFFFF) * s
+    int t;
+    asm("v_mul_i32_i24_sdwa %0, %1, %2 dst_sel:DWORD dst_unused:UNUSED_PAD src0_sel:WORD_0 src1_sel:DWORD" : "=v"(t) : "v"(r), "v"(s));
+    return t;
+}
+
+static __device__ __forceinline__ int mmvq_gcn_mul_word1(const int r, const int s) { // (r >> 16) * s
+    int t;
+    asm("v_mul_i32_i24_sdwa %0, sext(%1), %2 dst_sel:DWORD dst_unused:UNUSED_PAD src0_sel:WORD_1 src1_sel:DWORD" : "=v"(t) : "v"(r), "v"(s));
+    return t;
+}
+
+struct mmvq_gcn_pair_x {   // one row's raw share of a block
+    int ql[2], qh[2], sc[2], d;
+};
+
+static __device__ __forceinline__ void mmvq_gcn_pair_load_x(mmvq_gcn_pair_x (&x)[2], const char * const (&xr)[2],
+        const uint32_t o, const uint32_t o_ql, const uint32_t o_qh, const uint32_t o_sc) {
+#pragma unroll
+    for (int r = 0; r < 2; ++r) {
+#pragma unroll
+        for (int i = 0; i < 2; ++i) {
+            x[r].ql[i] = mmvq_gcn_ld32_u(xr[r] + (o + o_ql) + 4*i);
+            x[r].qh[i] = mmvq_gcn_ld32_u(xr[r] + (o + o_qh) + 4*i);
+            x[r].sc[i] = mmvq_gcn_ld32_u(xr[r] + (o + o_sc) + 4*i);
+        }
+        x[r].d = *(const uint16_t *) (xr[r] + (o + 208));
+    }
+}
+
+// both rows' weights as packed pairs [group][dword][byte], their scales [row][group] and block scales
+static __device__ __forceinline__ void mmvq_gcn_pair_unpack(const mmvq_gcn_pair_x (&x)[2], const int gp, const int sh,
+        int (&pw)[2][2][4], int (&s)[2][2], float (&d6)[2]) {
+    const uint32_t sel[4] = { 0x0c040c00, 0x0c050c01, 0x0c060c02, 0x0c070c03 };   // byte c of row a, then of row b
+    int w[2][2][2];   // [row][group][dword]: 6-bit weights 0..63 per byte
+#pragma unroll
+    for (int r = 0; r < 2; ++r) {
+#pragma unroll
+        for (int i = 0; i < 2; ++i) {
+            const int      ql = x[r].ql[i];
+            const uint32_t qh = (uint32_t) x[r].qh[i] >> (2*gp);
+            w[r][0][i] = ( ql       & 0x0F0F0F0F) | ((qh << 4) & 0x30303030);
+            w[r][1][i] = ((ql >> 4) & 0x0F0F0F0F) | ( qh       & 0x30303030);
+        }
+        s[r][0] = (int8_t) (x[r].sc[0] >> sh);
+        s[r][1] = (int8_t) (x[r].sc[1] >> sh);
+        d6[r]   = __half2float(__ushort_as_half((unsigned short) x[r].d));
+    }
+#pragma unroll
+    for (int g = 0; g < 2; ++g) {
+#pragma unroll
+        for (int i = 0; i < 2; ++i) {
+#pragma unroll
+            for (int c = 0; c < 4; ++c) {
+                pw[g][i][c] = (int) __builtin_amdgcn_perm(w[1][g][i], w[0][g][i], sel[c]) - 0x00200020;
+            }
+        }
+    }
+}
+
+// one group of both rows (8 weights each) against activation bytes y0, y1 with scale d8
+static __device__ __forceinline__ void mmvq_gcn_pair_group(const int (&pw)[2][4], const int y0, const int y1,
+        const float d8, const int sa, const int sb, float & acc_a, float & acc_b) {
+    const int r = 0x8000
+        + mmvq_gcn_mul_pair_byte<0>(pw[0][0], y0) + mmvq_gcn_mul_pair_byte<1>(pw[0][1], y0)
+        + mmvq_gcn_mul_pair_byte<2>(pw[0][2], y0) + mmvq_gcn_mul_pair_byte<3>(pw[0][3], y0)
+        + mmvq_gcn_mul_pair_byte<0>(pw[1][0], y1) + mmvq_gcn_mul_pair_byte<1>(pw[1][1], y1)
+        + mmvq_gcn_mul_pair_byte<2>(pw[1][2], y1) + mmvq_gcn_mul_pair_byte<3>(pw[1][3], y1);
+    acc_a += d8 * (float) (mmvq_gcn_mul_word0(r, sa) - 0x8000*sa);
+    acc_b += d8 * (float)  mmvq_gcn_mul_word1(r, sb);
+}
+
+template <int ncols>
+__launch_bounds__(256, 1)
+static __global__ void mmvq_gcn_q6_K_pair(
+        const char * __restrict__ vx, const block_q8_1 * __restrict__ y, float * __restrict__ dst,
+        const int nblk, const int nrows, const int64_t stride_row, const int stride_col_y, const int stride_col_dst) {
+    const int lane = threadIdx.x;
+    const int row0 = (blockIdx.x*4 + __builtin_amdgcn_readfirstlane(threadIdx.y)) * 2;
+    if (row0 >= nrows) {
+        return;
+    }
+
+    const int hf = (lane >> 3) & 1;
+    const int gp = (lane >> 2) & 1;
+    const int p  = lane & 3;
+    const int sh = 8*((p >> 1) + 2*gp);      // its scales: byte l/16 + 2gp of scales[0..3] and of scales[4..7]
+
+    const uint32_t o_ql = hf*64 + gp*32 + 8*p;
+    const uint32_t o_qh = 128 + hf*32 + 8*p;
+    const uint32_t o_sc = 192 + hf*8;
+    const char * xr[2] = { vx + row0*stride_row, vx + min(row0 + 1, nrows - 1)*stride_row };
+
+    float acc[2][ncols] = {{0.0f}};
+
+    for (int ib = lane >> 4; ib < nblk; ib += 4) {
+        mmvq_gcn_pair_x x[2];
+        mmvq_gcn_pair_load_x(x, xr, ib*210, o_ql, o_qh, o_sc);
+        int yq[ncols][2][2], yd[ncols][2];   // q8_1 blocks of its two groups: 8*ib + 4*hf + gp and that + 2
+#pragma unroll
+        for (int j = 0; j < ncols; ++j) {
+#pragma unroll
+            for (int g = 0; g < 2; ++g) {
+                const block_q8_1 * q = y + j*stride_col_y + 8*ib + hf*4 + gp + 2*g;
+                yq[j][g][0] = ((const int *) q->qs)[2*p];
+                yq[j][g][1] = ((const int *) q->qs)[2*p + 1];
+                yd[j][g]    = *(const int *) &q->ds;
+            }
+        }
+        int   pw[2][2][4];
+        int   s[2][2];
+        float d6[2];
+        mmvq_gcn_pair_unpack(x, gp, sh, pw, s, d6);
+#pragma unroll
+        for (int j = 0; j < ncols; ++j) {
+            float sa = 0.0f;
+            float sb = 0.0f;
+#pragma unroll
+            for (int g = 0; g < 2; ++g) {
+                const float d8 = __half2float(__ushort_as_half((unsigned short) yd[j][g]));
+                mmvq_gcn_pair_group(pw[g], yq[j][g][0], yq[j][g][1], d8, s[0][g], s[1][g], sa, sb);
+            }
+            acc[0][j] += d6[0] * sa;
+            acc[1][j] += d6[1] * sb;
+        }
+    }
+
+#pragma unroll
+    for (int r = 0; r < 2; ++r) {
+#pragma unroll
+        for (int j = 0; j < ncols; ++j) {
+            const float v = warp_reduce_sum<64>(acc[r][j]);
+            if (lane == 0 && row0 + r < nrows) {
+                dst[j*stride_col_dst + row0 + r] = v;
+            }
+        }
+    }
+}
+
+// The pair kernel at 2-3 columns, a workgroup's activations shared through LDS. Counters (rocprofv3, gfx900) showed
+// the TA addresser 81% busy with every lane loading its own activations. Here the 4 waves step through the same
+// k-range together: per step, thread t < ncols*32 copies q8_1 block t (its scale as float) into one of two LDS
+// buffers (40-byte stride: 8-byte aligned qs, few bank conflicts), one barrier, and lanes read activations from LDS.
+// A step's weights go out before the store and barrier (they do not need them), the next step's copy during its math.
+template <int ncols>
+__launch_bounds__(256, 1)
+static __global__ void mmvq_gcn_q6_K_pair_lds(
+        const char * __restrict__ vx, const block_q8_1 * __restrict__ y, float * __restrict__ dst,
+        const int nblk, const int nrows, const int64_t stride_row, const int stride_col_y, const int stride_col_dst) {
+    constexpr int NB = 32;   // q8_1 blocks per column per step (4 q6_K blocks of 256)
+    constexpr int BS = 40;   // LDS bytes per block: float d, pad, 32 qs
+    __shared__ __align__(16) char ys[2][ncols*NB*BS];
+
+    const int lane = threadIdx.x;
+    const int wave = __builtin_amdgcn_readfirstlane(threadIdx.y);
+    const int tid  = wave*64 + lane;
+    const int row0 = (blockIdx.x*4 + wave) * 2;   // waves past the end run along for the barriers, write nothing
+
+    const int hf = (lane >> 3) & 1;
+    const int gp = (lane >> 2) & 1;
+    const int p  = lane & 3;
+    const int sh = 8*((p >> 1) + 2*gp);
+    const int bl = 8*(lane >> 4) + 4*hf + gp;      // its groups' q8_1 blocks in a step: bl and bl + 2
+
+    const uint32_t o_ql = hf*64 + gp*32 + 8*p;
+    const uint32_t o_qh = 128 + hf*32 + 8*p;
+    const uint32_t o_sc = 192 + hf*8;
+    const char * xr[2] = { vx + min(row0, nrows - 1)*stride_row, vx + min(row0 + 1, nrows - 1)*stride_row };
+
+    const bool copier = tid < ncols*NB;
+    const int  cj = tid / NB;
+    const int  cb = tid % NB;
+    int yr[9];   // ds and qs of the block being copied
+    auto load_yb = [&](const int st) {
+        if (copier && st*NB + cb < nblk*8) {
+            const int * b = (const int *) (y + cj*stride_col_y + st*NB + cb);
+#pragma unroll
+            for (int i = 0; i < 9; ++i) {
+                yr[i] = b[i];
+            }
+        }
+    };
+    auto store_yb = [&](const int buf) {
+        if (copier) {
+            char * d = ys[buf] + (cj*NB + cb)*BS;
+            *(float *) d = __half2float(__ushort_as_half((unsigned short) yr[0]));
+#pragma unroll
+            for (int i = 0; i < 4; ++i) {
+                ((int2 *) (d + 8))[i] = make_int2(yr[1 + 2*i], yr[2 + 2*i]);
+            }
+        }
+    };
+
+    float acc[2][ncols] = {{0.0f}};
+    const int nsteps = (nblk + 3) / 4;
+    load_yb(0);
+    for (int st = 0; st < nsteps; ++st) {
+        const int buf = st & 1;
+        const int ib  = 4*st + (lane >> 4);
+        mmvq_gcn_pair_x x[2];
+        mmvq_gcn_pair_load_x(x, xr, min(ib, nblk - 1)*210, o_ql, o_qh, o_sc);
+        store_yb(buf);
+        __syncthreads();
+        if (st + 1 < nsteps) {
+            load_yb(st + 1);
+        }
+        __builtin_amdgcn_sched_barrier(0);
+        if (ib < nblk) {
+            int   pw[2][2][4];
+            int   s[2][2];
+            float d6[2];
+            mmvq_gcn_pair_unpack(x, gp, sh, pw, s, d6);
+#pragma unroll
+            for (int j = 0; j < ncols; ++j) {
+                float sa = 0.0f;
+                float sb = 0.0f;
+#pragma unroll
+                for (int g = 0; g < 2; ++g) {
+                    const char * q  = ys[buf] + (j*NB + bl + 2*g)*BS;
+                    const int2   yy = ((const int2 *) (q + 8))[p];
+                    mmvq_gcn_pair_group(pw[g], yy.x, yy.y, *(const float *) q, s[0][g], s[1][g], sa, sb);
+                }
+                acc[0][j] += d6[0] * sa;
+                acc[1][j] += d6[1] * sb;
+            }
+        }
+    }
+
+#pragma unroll
+    for (int r = 0; r < 2; ++r) {
+#pragma unroll
+        for (int j = 0; j < ncols; ++j) {
+            const float v = warp_reduce_sum<64>(acc[r][j]);
+            if (lane == 0 && row0 + r < nrows) {
+                dst[j*stride_col_dst + row0 + r] = v;
+            }
+        }
+    }
+}
+
+template <int ncols, int R>
+static void mmvq_gcn_q6_K_launch(const char * vx, const char * vgate, const block_q8_1 * y, float * dst,
+        const int nblk, const int nrows, const int64_t stride_row, const int stride_col_y, const int stride_col_dst,
+        const ggml_glu_op glu, cudaStream_t stream) {
+    const dim3 block_nums((nrows + 4*R - 1) / (4*R), 1, 1);
+    const dim3 block_dims(64, 4, 1);
+    static const bool pair = [] { const char * s = getenv("GGML_CUDA_MMVQ_GCN_PAIR"); return !s || atoi(s) != 0; }();
+    // pair kernels: 1 column; 3, and 2 with rows over 8192, through LDS (2 columns at k 4096 is a wash)
+    if (pair && !vgate) {
+        if constexpr (ncols == 1) {
+            mmvq_gcn_q6_K_pair<1><<<block_nums, block_dims, 0, stream>>>(
+                vx, y, dst, nblk, nrows, stride_row, stride_col_y, stride_col_dst);
+            return;
+        } else {
+            if (ncols == 3 || nblk > 32) {
+                mmvq_gcn_q6_K_pair_lds<ncols><<<block_nums, block_dims, 0, stream>>>(
+                    vx, y, dst, nblk, nrows, stride_row, stride_col_y, stride_col_dst);
+                return;
+            }
+        }
+    }
+    if (vgate) {
+        if constexpr (ncols == 1) {
+            mmvq_gcn_q6_K<ncols, R, true><<<block_nums, block_dims, 0, stream>>>(
+                vx, vgate, y, dst, nblk, nrows, stride_row, stride_col_y, stride_col_dst, glu);
+        }
+        return;
+    }
+    mmvq_gcn_q6_K<ncols, R, false><<<block_nums, block_dims, 0, stream>>>(
+        vx, nullptr, y, dst, nblk, nrows, stride_row, stride_col_y, stride_col_dst, glu);
+}
+
+bool ggml_cuda_mmvq_gcn_try(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1,
+                            ggml_tensor * dst, const ggml_cuda_mm_fusion_args_host * fusion) {
+    static const bool enabled = [] { const char * s = getenv("GGML_CUDA_MMVQ_GCN"); return !s || atoi(s) != 0; }();
+    const ggml_type type = src0->type;
+    // (A q4_0 version - packed 16-bit multiply-adds on activations stored as int16 pairs, 2x fewer instructions - was
+    // no faster than the generic kernel on Gemma 4 12B's rows, 193-238 vs 217-224 GB/s: at the 200 W cap q4_0 is held
+    // by the memory clock the card drops to, not by instructions.)
+    if (!enabled || !GGML_CUDA_CC_IS_GCN(ggml_cuda_info().devices[ctx.device].cc) || type != GGML_TYPE_Q6_K) {
+        return false;
+    }
+    const int64_t ncols = src1->ne[1];
+    // At 1 column with long rows (k 12288) the generic kernel is faster since AVFS is on (284 vs 246 GB/s); at 4 columns
+    // both run ~155. (An fp16 version - weights unpacked once to half2, packed FMAs per column, 32% fewer instructions at
+    // 3 columns - was slower at every width: 208 vs 170 us at 12288x4096x3.)
+    if (ncols < 1 || ncols > 3 || (ncols == 1 && src0->ne[0] > 8192) || src0->ne[0] % QK_K != 0 ||
+        src0->ne[2] != 1 || src0->ne[3] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1 ||
+        ggml_backend_buffer_get_usage(src0->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE) {
+        return false;
+    }
+    const char * vgate = nullptr;
+    ggml_glu_op glu = GGML_GLU_OP_SWIGLU;
+    if (fusion) {
+        if (fusion->x_bias || fusion->gate_bias || fusion->x_scale || fusion->gate_scale || !fusion->gate || ncols != 1 ||
+            !(fusion->glu_op == GGML_GLU_OP_SWIGLU || fusion->glu_op == GGML_GLU_OP_GEGLU)) {
+            return false;
+        }
+        vgate = (const char *) fusion->gate->data;
+        glu   = fusion->glu_op;
+    }
+
+    cudaStream_t stream = ctx.stream();
+    const int64_t ne10       = src1->ne[0];
+    const int64_t s11        = src1->nb[1]/sizeof(float);
+    const char  * vx         = (const char *) src0->data;
+    float       * d          = (float *) dst->data;
+    const int     nrows      = src0->ne[1];
+    const int     stride_dst = dst->nb[1] / sizeof(float);
+
+    const int64_t ne10_padded = GGML_PAD(ne10, MATRIX_ROW_PADDING);
+    ggml_cuda_pool_alloc<char> src1_q8_1(ctx.pool(), ncols*ne10_padded*sizeof(block_q8_1)/QK8_1);
+    quantize_row_q8_1_cuda((const float *) src1->data, nullptr, src1_q8_1.get(), type, ne10,
+        s11, src1->nb[2]/sizeof(float), src1->nb[3]/sizeof(float), ne10_padded, ncols, 1, 1, stream);
+
+    const block_q8_1 * y   = (const block_q8_1 *) src1_q8_1.get();
+    const int nblk         = src0->ne[0] / QK_K;
+    const int stride_col_y = ne10_padded / QK8_1;
+    switch (ncols) {
+        case 1: mmvq_gcn_q6_K_launch<1, 2>(vx, vgate, y, d, nblk, nrows, src0->nb[1], stride_col_y, stride_dst, glu, stream); break;
+        case 2: mmvq_gcn_q6_K_launch<2, 2>(vx, vgate, y, d, nblk, nrows, src0->nb[1], stride_col_y, stride_dst, glu, stream); break;
+        case 3: mmvq_gcn_q6_K_launch<3, 2>(vx, vgate, y, d, nblk, nrows, src0->nb[1], stride_col_y, stride_dst, glu, stream); break;
+    }
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+}
+#endif // !defined(GGML_USE_HIP)
