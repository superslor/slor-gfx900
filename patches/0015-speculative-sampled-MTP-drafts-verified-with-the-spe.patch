-            sparams.top_k    = 10;
+            // LLAMA_SPEC_DRAFT_TOPK: candidates the draft keeps (default 10)
+            sparams.top_k    = getenv("LLAMA_SPEC_DRAFT_TOPK") ? atoi(getenv("LLAMA_SPEC_DRAFT_TOPK")) : 10;
