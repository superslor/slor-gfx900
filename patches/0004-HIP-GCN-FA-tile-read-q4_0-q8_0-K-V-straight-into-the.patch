 // Function that performs a single iteration in for the KQ matrix multiplication:
+// load a tile of q8_0 K straight into shared memory, as the q4_0 loader above does.
+// The live cache is K q8_0 / V q4_0, which missed the q4_0-only direct path, so every 3-5 token verify step
+// converted the WHOLE cache to f16 first (2.04 ms per call at kv=65536 vs 0.83 for q4_0/q4_0, one P100).
+// Each int8 value becomes exact fp16 by the magic-number trick (OR q+128 into the mantissa of 1024.0h, subtract
+// 1152), then one hmul2 by the block scale: the exact product rounded once to fp16, i.e. the same value the
+// whole-cache to_fp16 conversion produces, so the tile -- and everything after it -- is bit-identical.
+// A slot covers 2*cpy_ne values at a 2*cpy_ne-aligned offset, which never straddles a 32-value block.
+template<int warp_size, int nwarps, int I, int J, int J_padding, bool oob_check>
+static __device__ __forceinline__ void flash_attn_tile_load_tile_q8_0(
+        const char * const __restrict__ KV, half2 * const __restrict__ tile_KV,
+        const int stride_KV, const int i_sup, const int k_dim_0) {
+    constexpr int cpy_nb = ggml_cuda_get_max_cpy_bytes();
+    constexpr int cpy_ne = cpy_nb / 4;          // half2 per 16-byte copy
+    constexpr int VPS    = 2*cpy_ne;            // values per slot
+    constexpr int NSLOT  = J / VPS;             // slots per row
+    constexpr int nthr   = nwarps*warp_size;
+
+    static_assert(J % VPS == 0, "bad J");
+    static_assert(QK8_0 % VPS == 0, "bad cpy_ne");
+    static_assert(QK8_0 == 32, "bad QK8_0");
+
+    const int tid = threadIdx.y*warp_size + threadIdx.x;
+
+#pragma unroll
+    for (int w0 = 0; w0 < I*NSLOT; w0 += nthr) {
+        const int w = w0 + tid;
+        if (w0 + nthr <= I*NSLOT || w < I*NSLOT) {
+            const int i = w / NSLOT;
+            const int a = k_dim_0 + (w % NSLOT)*VPS;   // absolute head dim of the slot's first value
+
+            __align__(16) half2 out[cpy_ne];
+
+            if (!oob_check || i < i_sup) {
+                const block_q8_0 * blk = (const block_q8_0 *) (KV + i*stride_KV) + a/QK8_0;
+                const half2 dh = __half2half2(blk->d);
+                // qs sits at offset 2 in a 34-byte block: only 2-byte aligned, so read uint16 pairs
+                const uint16_t * qs16 = (const uint16_t *) (blk->qs + a % QK8_0);
+                const half2 k1152 = __float2half2_rn(1152.0f);
+#pragma unroll
+                for (int l = 0; l < cpy_ne; ++l) {
+                    const uint32_t b = __byte_perm((uint32_t) qs16[l], 0, 0x4140);   // lane0 = byte0, lane1 = byte1
+                    const uint32_t u = (b ^ 0x00800080) | 0x64006400;              // 1024 + (q + 128), exact
+                    half2 h;
+                    memcpy(&h, &u, sizeof(h));
+                    out[l] = __hmul2(__hsub2(h, k1152), dh);
+                }
+            } else {
+#pragma unroll
+                for (int l = 0; l < cpy_ne; ++l) {
+                    out[l] = make_half2(0.0f, 0.0f);
+                }
+            }
+
+            ggml_cuda_memcpy_1<sizeof(out)>(tile_KV + i*(J/2 + J_padding) + (a - k_dim_0)/2, out);
+        }
+    }
+}
+
+// Same, for the fp32 tile (architectures without fast fp16).
+template<int warp_size, int nwarps, int I, int J, int J_padding, bool oob_check>
+static __device__ __forceinline__ void flash_attn_tile_load_tile_q8_0(
+        const char * const __restrict__ KV, float * const __restrict__ tile_KV,
+        const int stride_KV, const int i_sup, const int k_dim_0) {
+    constexpr int nthr = nwarps*warp_size;
+    const int tid = threadIdx.y*warp_size + threadIdx.x;
+#pragma unroll
+    for (int w0 = 0; w0 < I*J; w0 += nthr) {
+        const int w = w0 + tid;
+        if (w0 + nthr <= I*J || w < I*J) {
+            const int i = w / J;
+            const int j = w % J;
+            float v = 0.0f;
+            if (!oob_check || i < i_sup) {
+                const int a = k_dim_0 + j;
+                const block_q8_0 * blk = (const block_q8_0 *) (KV + i*stride_KV) + a/QK8_0;
+                v = __half2float(__hmul(__int2half_rn(blk->qs[a % QK8_0]), blk->d));
+            }
+            tile_KV[i*(J + J_padding) + j] = v;
+        }
+    }
+}
