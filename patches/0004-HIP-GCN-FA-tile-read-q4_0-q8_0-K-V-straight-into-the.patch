+#ifdef FAST_FP16_AVAILABLE
+    // (np == 1 only - every NVIDIA fp16 config. With np > 1 (AMD configs) VKQ keeps upstream's whole-cache
+    // accumulation, because the cross-warp combine exchanges VKQ; the kernel copies it into VKQ_f at the end.)
+    // Fold the tile's half2 partial sums into the fp32 running accumulator and reset.
