+// single-token attention under a sliding window - only keys w0 .. w0+wn (mod kv) are visible, the way
+// a token sees its 1024 of the window layers' ring of cells.
+struct test_flash_attn_ext_window : public test_flash_attn_ext {
+    const int64_t w0;
+    const int64_t wn;
+
+    std::string vars() override {
+        return test_flash_attn_ext::vars() + "," + VARS_TO_STR2(w0, wn);
+    }
+
+    test_flash_attn_ext_window(int64_t hs, int64_t nh, int64_t nr, int64_t kv, int64_t w0, int64_t wn,
+                               std::array<int32_t, 4> permute = {0, 1, 2, 3})
+        : test_flash_attn_ext(hs, hs, nh, {nr, 1}, kv, 1, true, false, 0.0f, 0.0f, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16, permute),
+          w0(w0), wn(wn) {}
+
+    void initialize_tensors(ggml_context * ctx) override {
+        test_flash_attn_ext::initialize_tensors(ctx);
+        ggml_tensor * m = ggml_get_tensor(ctx, "m");
+        std::vector<ggml_fp16_t> data(ggml_nelements(m), ggml_fp32_to_fp16(-INFINITY));
+        for (int64_t i = 0; i < wn; ++i) {
+            data[(w0 + i) % kv] = ggml_fp32_to_fp16(0.0f);
+        }
+        ggml_backend_tensor_set(m, data.data(), 0, data.size()*sizeof(ggml_fp16_t));
+    }
+};
+
+// prompt reading under a causal sliding window - nb new tokens are the last nb of kv cells (token j sits
+// at kv - nb + j) and each sees the win cells up to itself, as Gemma 4's window layers do while reading a prompt.
+struct test_flash_attn_ext_swa_prefill : public test_flash_attn_ext {
+    const int64_t win;
+
+    std::string vars() override {
+        return test_flash_attn_ext::vars() + "," + VARS_TO_STR1(win);
+    }
+
+    uint64_t op_flops(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return 2 * nh*nr23[0] * nb * (hsk + hsv) * std::min<int64_t>(win, kv);   // the visible keys only
+    }
+
+    test_flash_attn_ext_swa_prefill(int64_t hs, int64_t nh, int64_t nr, int64_t kv, int64_t nb, int64_t win)
+        : test_flash_attn_ext(hs, hs, nh, {nr, 1}, kv, nb, true, false, 0.0f, 0.0f, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16,
+                              {0, 2, 1, 3}),
+          win(win) {}
+
+    void initialize_tensors(ggml_context * ctx) override {
+        test_flash_attn_ext::initialize_tensors(ctx);
+        ggml_tensor * m = ggml_get_tensor(ctx, "m");
+        std::vector<ggml_fp16_t> data(ggml_nelements(m), ggml_fp32_to_fp16(-INFINITY));
+        for (int64_t j = 0; j < nb; ++j) {
+            const int64_t pos = kv - nb + j;
+            for (int64_t k = std::max<int64_t>(0, pos - win + 1); k <= pos; ++k) {
+                data[j*kv + k] = ggml_fp32_to_fp16(0.0f);
+            }
+        }
+        ggml_backend_tensor_set(m, data.data(), 0, data.size()*sizeof(ggml_fp16_t));
+    }
+};
