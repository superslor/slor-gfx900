+// CONCAT along dim 0 of a contiguous state and a transposed view - Qwen3.5's linear-attention conv
+// state (3 x 8192) joined with the new tokens (the ssm_conv input), which takes concat_dim0_transpose_u32
+struct test_concat_state_t : public test_case {
+    const int64_t n_state;
+    const int64_t n_tok;
+    const int64_t n_ch;
+
+    std::string vars() override {
+        return VARS_TO_STR3(n_state, n_tok, n_ch);
+    }
+
+    test_concat_state_t(int64_t n_state = 3, int64_t n_tok = 3, int64_t n_ch = 8192)
+        : n_state(n_state), n_tok(n_tok), n_ch(n_ch) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_state, n_ch);
+        ggml_set_name(a, "a");
+        ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_ch, n_tok);
+        ggml_set_name(x, "x");
+        ggml_tensor * b = ggml_transpose(ctx, x);
+        ggml_set_name(b, "x_t");
+        ggml_tensor * out = ggml_concat(ctx, a, b, 0);
+        ggml_set_name(out, "out");
+        return out;
+    }
+};
