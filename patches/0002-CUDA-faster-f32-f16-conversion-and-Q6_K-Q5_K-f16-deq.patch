 static __global__ void dequantize_block_q6_K(const void * __restrict__ vx, dst_t * __restrict__ yy) {
     const int64_t i = blockIdx.x;
@@ -386,12 +502,26 @@ static void dequantize_row_q4_K_cuda(const void * vx, dst_t * y, const int64_t k
 template<typename dst_t>
 static void dequantize_row_q5_K_cuda(const void * vx, dst_t * y, const int64_t k, cudaStream_t stream) {
     const int nb = k / QK_K;
+    if constexpr (std::is_same<dst_t, half>::value) {
+        static const bool fast = [] { const char * e = getenv("GGML_CUDA_DEQ_FAST"); return !e || e[0] != '0'; }();
+        if (fast) {
