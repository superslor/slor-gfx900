From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: superslor <289523157+superslor@users.noreply.github.com>
Date: Fri, 6 Nov 2026 18:16:38 -0600
Subject: [PATCH 08/19] HIP GCN: get_rows in 64-thread blocks, concat through
 the dim-0 transpose kernel

Qwen3.5's recurrent-state gather copies a 2 MB row per linear-attention layer: 54.4 -> 12.1 us.
Its conv-state concat took the generic non-contiguous kernel: 38.5 -> 5.8 us.
GGML_CUDA_GET_ROWS_GCN64=0 / GGML_CUDA_CONCAT_T_GCN=0 turn them off.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TS8XWm5bp2cWmYvbQ5tTBK
---
 ggml/src/ggml-cuda/concat.cu  | 5 ++++-
 ggml/src/ggml-cuda/getrows.cu | 8 ++++++--
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/ggml/src/ggml-cuda/concat.cu b/ggml/src/ggml-cuda/concat.cu
index f59708892..eb68cc81d 100644
--- a/ggml/src/ggml-cuda/concat.cu
+++ b/ggml/src/ggml-cuda/concat.cu
@@ -200,7 +200,10 @@ static void concat_cuda(const ggml_tensor * src0, const ggml_tensor * src1, ggml
 
         dim3 grid_dim(dst->ne[1], dst->ne[2], dst->ne[3]);
         if constexpr (sizeof(T) == sizeof(uint32_t)) {
-            const bool transpose_dim0 = ggml_cuda_info().devices[ggml_cuda_get_device()].cc == GGML_CUDA_CC_DGX_SPARK &&
+            const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+            // also on GCN - Qwen3.5's conv-state concat took 40 us in the generic kernel there
+            static const bool gcn_t = [] { const char * s = getenv("GGML_CUDA_CONCAT_T_GCN"); return !s || atoi(s) != 0; }();
+            const bool transpose_dim0 = (cc == GGML_CUDA_CC_DGX_SPARK || (gcn_t && GGML_CUDA_CC_IS_GCN(cc))) &&
                 dim == 0 && src0->ne[2] == 1 && src0->ne[3] == 1 && src1->ne[2] == 1 && src1->ne[3] == 1 &&
                 dst->ne[2] == 1 && dst->ne[3] == 1 && src0->ne[0] <= 8 &&
                 src0->nb[0] == sizeof(uint32_t) && src0->nb[1] == (uint64_t) src0->ne[0]*sizeof(uint32_t) &&
diff --git a/ggml/src/ggml-cuda/getrows.cu b/ggml/src/ggml-cuda/getrows.cu
index 6b4453bc6..dab11ae1b 100644
--- a/ggml/src/ggml-cuda/getrows.cu
+++ b/ggml/src/ggml-cuda/getrows.cu
@@ -257,7 +257,11 @@ static void get_rows_cuda_float(
     if constexpr (std::is_same<src0_t, dst_t>::value) {
         constexpr int VEC = 16 / sizeof(dst_t);
         const int64_t ne00v = ne00 / VEC;
-        const int64_t vec_block_num_y = (ne00v + CUDA_GET_ROWS_BLOCK_SIZE - 1) / CUDA_GET_ROWS_BLOCK_SIZE;
+        // 64-thread blocks on GCN. Qwen3.5's 2 MB recurrent-state rows ran at ~80 GB/s in 256-thread
+        // blocks of one int4 per thread (52 us a layer, kernel trace); the same copy in 64-thread blocks is 4x faster.
+        static const bool gcn64 = [] { const char * s = getenv("GGML_CUDA_GET_ROWS_GCN64"); return !s || atoi(s) != 0; }();
+        const int vbs = gcn64 && GGML_CUDA_CC_IS_GCN(ggml_cuda_info().devices[ggml_cuda_get_device()].cc) ? 64 : CUDA_GET_ROWS_BLOCK_SIZE;
+        const int64_t vec_block_num_y = (ne00v + vbs - 1) / vbs;
         const bool enough_blocks = vec_block_num_y * ne10 * ne11 * ne12 >= 128;
         const bool can_vec = VEC > 1 && enough_blocks &&
             (ne00 % VEC == 0) &&
@@ -268,7 +272,7 @@ static void get_rows_cuda_float(
         if (can_vec) {
             const int block_num_y = vec_block_num_y;
             const dim3 block_nums(ne10, MIN(block_num_y, UINT16_MAX), MIN(ne11*ne12, UINT16_MAX));
-            const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params{block_nums, block_dims, 0, stream};
+            const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params{block_nums, dim3(vbs, 1, 1), 0, stream};
             ggml_cuda_kernel_launch(k_get_rows_float_vec<dst_t>, launch_params,
                 (const dst_t *) src0_d, src1_d, dst_d,
                 ne00v, ne11, ne12_fdv,
