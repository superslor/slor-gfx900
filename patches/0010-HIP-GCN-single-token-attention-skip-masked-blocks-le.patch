+// flash_attn_combine_results for one token over the blocks with a nonzero sum: a skipped block (all keys masked)
+// never wrote its partial output. The live blocks are listed first, in order, so their loads can be in flight together.
+template <int D>
+__launch_bounds__(D, 1)
+static __global__ void fattn_gcn_combine(
+        const float * __restrict__ parts, const float2 * __restrict__ meta_g, float * __restrict__ dst, const int nchunks) {
+    static_assert(D >= 64, "one full wave lists the live blocks");
+    const int head = blockIdx.x;
+    const int tid  = threadIdx.x;
+    parts  += (int64_t) head*nchunks*D;
+    meta_g += (int64_t) head*nchunks;
+    dst    += (int64_t) head*D;
+
+    extern __shared__ float2 meta[];
+    int * live = (int *) (meta + nchunks);
+    __shared__ int nlive_s;
+    for (int i = tid; i < nchunks; i += D) {
+        meta[i] = meta_g[i];
+    }
+    __syncthreads();
+
+    if (tid < 64) {
+        int n = 0;
+        for (int l0 = 0; l0 < nchunks; l0 += 64) {
+            const int      l = l0 + tid;
+            const bool     v = l < nchunks && meta[l].y != 0.0f;
+            const uint64_t b = __ballot(v);
+            if (v) {
+                live[n + __popcll(b & ((1ull << tid) - 1))] = l;
+            }
+            n += __popcll(b);
+        }
+        if (tid == 0) {
+            nlive_s = n;
+        }
+    }
+    __syncthreads();
+    const int nlive = nlive_s;
+
+    if (nlive == 0) {
+        dst[tid] = 0.0f;
+        return;
+    }
+    float kqmax = -FLT_MAX / 2.0f;
+    for (int i = 0; i < nlive; ++i) {
+        kqmax = fmaxf(kqmax, meta[live[i]].x);
+    }
+    // 8 partial outputs loaded before any is used (a plain loop waited on memory once per part); past the end the
+    // index stays on the last live block and its weight is 0, so the sums are the same, in the same order
+    constexpr int NB = 8;
+    float num = 0.0f;
+    float den = 0.0f;
+    for (int i0 = 0; i0 < nlive; i0 += NB) {
+        float p[NB];
+#pragma unroll
+        for (int u = 0; u < NB; ++u) {
+            p[u] = parts[live[min(i0 + u, nlive - 1)]*D + tid];
+        }
+#pragma unroll
+        for (int u = 0; u < NB; ++u) {
+            if (i0 + u < nlive) {
+                const float2 ml = meta[live[i0 + u]];
+                const float  sc = expf(ml.x - kqmax);
+                num += sc * p[u];
+                den += sc * ml.y;
+            }
+        }
+    }
+    dst[tid] = num / den;
+}
