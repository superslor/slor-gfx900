Date: Thu, 5 Nov 2026 04:56:50 -0600
Subject: [PATCH 06/19] HIP GCN: gated delta net kernel for S_v 128

A group of 8 lanes owns one state column, so the per-token sums use DPP/swizzle inside the group
instead of 64-lane LDS permutes; k, q and the gates are staged in LDS 16 tokens at a time.
MI25, 32 heads x 128: 512 tokens 4082 -> 885 us, 1 token 63 -> 24 us. GGML_CUDA_GDN_GCN=0 restores the
generic kernel.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TS8XWm5bp2cWmYvbQ5tTBK
---
 ggml/src/ggml-cuda/gated_delta_net.cu | 146 ++++++++++++++++++++++++++
 1 file changed, 146 insertions(+)

diff --git a/ggml/src/ggml-cuda/gated_delta_net.cu b/ggml/src/ggml-cuda/gated_delta_net.cu
index 5cf6968a6..ddd03c8f6 100644
--- a/ggml/src/ggml-cuda/gated_delta_net.cu
+++ b/ggml/src/ggml-cuda/gated_delta_net.cu
@@ -202,6 +202,130 @@ gated_delta_net_cuda(const float * q,
     }
 }
 
+#if defined(GGML_USE_HIP)
+// GCN (gfx900/906): its 64-lane reductions go through LDS permutes. Here a group of G lanes owns one column, so the two
+// per-token sums need only G-lane DPP moves. k, q and the gates are staged in LDS TCH tokens at a time.
+template <int G>
+static __device__ __forceinline__ float gdn_gcn_group_sum(float x) {
+    static_assert(G == 2 || G == 4 || G == 8, "bad G");
+    x += __int_as_float(__builtin_amdgcn_mov_dpp(__float_as_int(x), 0xB1, 0xF, 0xF, false)); // lane ^ 1
+    if constexpr (G >= 4) {
+        x += __int_as_float(__builtin_amdgcn_mov_dpp(__float_as_int(x), 0x4E, 0xF, 0xF, false)); // lane ^ 2
+    }
+    if constexpr (G >= 8) {
+        x += __int_as_float(__builtin_amdgcn_ds_swizzle(__float_as_int(x), 0x101F)); // lane ^ 4
+    }
+    return x;
+}
+
+// CONTIG: each lane holds R contiguous rows (full cache lines for the state; for 1-4 token calls), else rows gl + G*r (conflict-free LDS).
+template <int S_v, int G, int CB, int TCH, bool keep_rs_t, bool RAW, bool CONTIG>
+__global__ void __launch_bounds__(CB*G, 1)
+gated_delta_net_gcn(const float * q, const float * k, const float * v, const float * g, const float * beta,
+                    const float * raw_dt_bias, const float * raw_a, const float * curr_state, float * dst, float * state,
+                    int64_t H, int64_t n_tokens, int64_t n_seqs, int64_t sq1, int64_t sq2, int64_t sq3,
+                    int64_t sv1, int64_t sv2, int64_t sv3, int64_t sb1, int64_t sb2, int64_t sb3,
+                    const uint3 neqk1_magic, const uint3 rq3_magic, float scale, int64_t state_slot_stride, int K) {
+    constexpr int R = S_v / G;
+#define ROW(r) (CONTIG ? gl*R + (r) : gl + G*(r))
+    static_assert(S_v % G == 0 && S_v % CB == 0, "bad S_v / G / CB");
+
+    const uint32_t h_idx    = blockIdx.x;
+    const uint32_t sequence = blockIdx.y;
+    const int      tid      = threadIdx.x;
+    const int      gl       = tid % G;
+    const int      col      = blockIdx.z*CB + tid / G;
+
+    const uint32_t iq1 = fastmodulo(h_idx, neqk1_magic);
+    const uint32_t iq3 = fastdiv(sequence, rq3_magic);
+
+    curr_state += sequence * H * S_v * S_v + h_idx * S_v * S_v;
+    state      += (sequence * H + h_idx) * S_v * S_v;
+    float * attn_data = dst + (sequence * n_tokens * H + h_idx) * S_v;
+
+    __shared__ float k_s[TCH][S_v];
+    __shared__ float q_s[TCH][S_v];
+    __shared__ float gb_s[TCH][2];
+
+    ggml_cuda_pdl_sync();
+    float s[R];
+#pragma unroll
+    for (int r = 0; r < R; ++r) {
+        s[r] = curr_state[col*S_v + ROW(r)];
+    }
+
+    for (int64_t t0 = 0; t0 < n_tokens; t0 += TCH) {
+        const int nt = n_tokens - t0 < TCH ? (int) (n_tokens - t0) : TCH;
+        __syncthreads();
+        for (int idx = tid; idx < nt*S_v; idx += CB*G) {
+            const int     tt  = idx / S_v;
+            const int     i   = idx % S_v;
+            const int64_t off = iq3*sq3 + (t0 + tt)*sq2 + iq1*sq1;
+            k_s[tt][i] = k[off + i];
+            q_s[tt][i] = q[off + i];
+        }
+        for (int tt = tid; tt < nt; tt += CB*G) {
+            const int64_t gb_off = sequence*sb3 + (t0 + tt)*sb2 + h_idx*sb1;
+            float b  = beta[gb_off];
+            float g0 = g[gb_off];
+            if constexpr (RAW) {
+                b = 1.0f / (1.0f + expf(-b));
+                const float x = g0 + raw_dt_bias[h_idx];
+                g0 = raw_a[h_idx] * ((x > 20.0f) ? x : logf(1.0f + expf(x)));
+            }
+            gb_s[tt][0] = expf(g0);
+            gb_s[tt][1] = b;
+        }
+        __syncthreads();
+
+        for (int tt = 0; tt < nt; ++tt) {
+            const int64_t t     = t0 + tt;
+            const float   g_val = gb_s[tt][0];
+            const float   v_col = v[sequence*sv3 + t*sv2 + h_idx*sv1 + col];
+
+            float kv = 0.0f;
+#pragma unroll
+            for (int r = 0; r < R; ++r) {
+                kv += s[r] * k_s[tt][ROW(r)];
+            }
+            kv = gdn_gcn_group_sum<G>(kv);
+
+            const float delta = (v_col - g_val*kv) * gb_s[tt][1];
+
+            float attn = 0.0f;
+#pragma unroll
+            for (int r = 0; r < R; ++r) {
+                s[r]  = g_val*s[r] + k_s[tt][ROW(r)]*delta;
+                attn += s[r] * q_s[tt][ROW(r)];
+            }
+            attn = gdn_gcn_group_sum<G>(attn);
+            if (gl == 0) {
+                attn_data[t*S_v*H + col] = attn * scale;
+            }
+
+            if constexpr (keep_rs_t) {
+                const int target_slot = (int) (n_tokens - 1 - t);
+                if (target_slot < K) {
+                    float * slot = state + target_slot * state_slot_stride;
+#pragma unroll
+                    for (int r = 0; r < R; ++r) {
+                        slot[col*S_v + ROW(r)] = s[r];
+                    }
+                }
+            }
+        }
+    }
+
+    if constexpr (!keep_rs_t) {
+#pragma unroll
+        for (int r = 0; r < R; ++r) {
+            state[col*S_v + ROW(r)] = s[r];
+        }
+    }
+}
+#undef ROW
+#endif // defined(GGML_USE_HIP)
+
 template <bool KDA, bool keep_rs_t, bool RAW, bool G_PRECOMPUTED>
 static void launch_gated_delta_net(
         const float * q_d, const float * k_d, const float * v_d,
@@ -224,6 +348,28 @@ static void launch_gated_delta_net(
     const uint3 neqk1_magic = init_fastdiv_values(neqk1);
     const uint3 rq3_magic   = init_fastdiv_values(rq3);
 
+#if defined(GGML_USE_HIP)
+    static const bool gcn_on = [] { const char * e = getenv("GGML_CUDA_GDN_GCN"); return !e || e[0] != '0'; }();
+    if constexpr (!KDA && !G_PRECOMPUTED) {
+        if (gcn_on && GGML_CUDA_CC_IS_GCN(cc) && S_v == 128) {
+            constexpr int G = 8, CB = 64, TCH = 16;
+            const ggml_cuda_kernel_launch_params gcn_params = ggml_cuda_kernel_launch_params(dim3(H, n_seqs, 128/CB), dim3(CB*G, 1, 1), 0, stream);
+            if (n_tokens <= 4) {
+                ggml_cuda_kernel_launch(gated_delta_net_gcn<128, G, CB, TCH, keep_rs_t, RAW, true>, gcn_params,
+                    q_d, k_d, v_d, g_d, b_d, rb_d, ra_d, s_d, dst_d, state_d, H,
+                    n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
+                    sb1, sb2, sb3, neqk1_magic, rq3_magic, scale, state_slot_stride, K);
+            } else {
+                ggml_cuda_kernel_launch(gated_delta_net_gcn<128, G, CB, TCH, keep_rs_t, RAW, false>, gcn_params,
+                    q_d, k_d, v_d, g_d, b_d, rb_d, ra_d, s_d, dst_d, state_d, H,
+                    n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
+                    sb1, sb2, sb3, neqk1_magic, rq3_magic, scale, state_slot_stride, K);
+            }
+            return;
+        }
+    }
+#endif // defined(GGML_USE_HIP)
