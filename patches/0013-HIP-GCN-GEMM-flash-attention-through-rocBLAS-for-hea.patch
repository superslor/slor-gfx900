+// Whether the GEMM path takes this FA op. ggml_cuda_flash_attn_ext and get_alloc_size must agree, or the f16 staging is
+// reserved for nothing (AMD with GGML_CUDA_FA_GEMM=1 did that: its cc is far above VOLTA).
+static bool ggml_cuda_fa_gemm_takes(const ggml_tensor * dst, const int cc) {
+    static const bool gemm_amd = [] { const char * s = getenv("GGML_CUDA_FA_GEMM"); return s && s[0] == '1'; }();
+    // On GCN the GEMM path takes D >= 512 by default (Gemma 4's global layers: fp32, tuned rocBLAS, 2048 tokens
+    // at 16k 204 -> 151 ms or less); D256 stays on the tile kernel (window layers waste most of a GEMM; Qwen3.5 +3% only).
+    // GGML_CUDA_FA_GEMM=1 sends every supported shape on GCN to it, =0 none.
+    const bool gcn = GGML_CUDA_CC_IS_GCN(cc) && (gemm_amd || dst->src[1]->ne[0] >= 512);
+    return ggml_cuda_fa_gemm_enabled() && ggml_cuda_flash_attn_ext_gemm_supported(dst) && gcn;
+}
