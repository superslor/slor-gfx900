diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 6e3e1b94f..5b113af79 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -82,6 +82,7 @@
 #include <initializer_list>
 #include <limits>
 #include <map>
+#include <chrono>
 #include <memory>
 #include <mutex>
 #include <cstdarg>
@@ -4152,6 +4153,110 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
     return 0;
 }
 
+// GGML_CUDA_OP_PROF=N - GPU time per op, summed and printed to stderr every N graph evaluations. Run it
+// with GGML_CUDA_DISABLE_GRAPHS=1 so nodes are launched rather than replayed. An event goes down before each node, so
+// work a node fuses with the ones after it counts under that node; "wall" is the time between evaluation starts.
+struct ggml_cuda_op_prof {
+    int every = 0;
+    int evals = 0;
+    std::vector<cudaEvent_t> ev;
+    std::vector<std::string> label;
+    std::vector<char>        rec;      // recorded this evaluation (fusion skips the nodes it consumed)
+    std::map<std::string, std::pair<int64_t, double>> acc;    // label -> (calls, ms)
+    double gpu_ms = 0.0, wall_ms = 0.0;
+    std::chrono::steady_clock::time_point last{};
+
+    ggml_cuda_op_prof() {
+        const char * e = getenv("GGML_CUDA_OP_PROF");
+        every = e ? atoi(e) : 0;
+    }
+
+    static std::string name_of(const ggml_tensor * t) {
+        char buf[192];
+        const ggml_tensor * a = t->src[0];
+        const ggml_tensor * b = t->src[1];
+        if ((t->op == GGML_OP_MUL_MAT || t->op == GGML_OP_MUL_MAT_ID) && a && b) {
+            snprintf(buf, sizeof(buf), "%s %s %lldx%lld x%lld", ggml_op_name(t->op), ggml_type_name(a->type),
+                     (long long) a->ne[1], (long long) a->ne[0], (long long) b->ne[1]);
+        } else if (t->op == GGML_OP_FLASH_ATTN_EXT && a && b) {
+            snprintf(buf, sizeof(buf), "FLASH_ATTN_EXT D%lld q%lldx%lld kv%s/%s", (long long) a->ne[0], (long long) a->ne[1],
+                     (long long) a->ne[2], ggml_type_name(b->type), ggml_type_name(t->src[2]->type));
+        } else {
+            snprintf(buf, sizeof(buf), "%s %s %lldx%lld", ggml_op_desc(t), a ? ggml_type_name(a->type) : "",
+                     (long long) t->ne[0], (long long) (t->ne[1]*t->ne[2]*t->ne[3]));
+        }
+        return buf;
+    }
+
+    void begin(const int n) {
+        while ((int) ev.size() < n + 1) {
+            cudaEvent_t e;
+            CUDA_CHECK(cudaEventCreate(&e));
+            ev.push_back(e);
+        }
+        label.assign(n, std::string());
+        rec.assign(n + 1, 0);
+        const auto now = std::chrono::steady_clock::now();
+        if (evals > 0) {
+            wall_ms += std::chrono::duration<double, std::milli>(now - last).count();
+        }
+        last = now;
+    }
+
+    void mark(const int i, const ggml_tensor * node, cudaStream_t stream) {
+        label[i] = name_of(node);
+        rec[i] = 1;
+        CUDA_CHECK(cudaEventRecord(ev[i], stream));
+    }
+
+    void end(const int n, cudaStream_t stream) {
+        CUDA_CHECK(cudaEventRecord(ev[n], stream));
+        rec[n] = 1;
+        CUDA_CHECK(cudaEventSynchronize(ev[n]));
+        // Each event against the first: HIP gives no timestamp to an event with no work since the previous one (it
+        // keeps the previous time), and a node that fusion consumed was never marked (skipped).
+        // Time between consecutive recorded events goes to the earlier one's node: the launch a fused node made.
+        int p = 0;          // node 0 is always marked
+        float tp = 0.0f;
+        for (int i = 1; i <= n; ++i) {
+            if (!rec[i]) {
+                continue;
+            }
+            float ti = 0.0f;
+            if (cudaEventElapsedTime(&ti, ev[0], ev[i]) != cudaSuccess) {
+                (void) cudaGetLastError();
+                ti = tp;
+            }
+            const float ms = std::max(0.0f, ti - tp);
+            auto & a = acc[label[p]];
+            a.first++;
+            a.second += ms;
+            gpu_ms += ms;
+            p  = i;
+            tp = std::max(tp, ti);
+        }
+        if (++evals % every == 0) {
+            std::vector<std::pair<std::string, std::pair<int64_t, double>>> v(acc.begin(), acc.end());
+            std::sort(v.begin(), v.end(), [](const auto & x, const auto & y) { return x.second.second > y.second.second; });
+            fprintf(stderr, "op-prof: %d evals, GPU %.3f ms/eval, wall %.3f ms/eval\n", every, gpu_ms / every,
+                    wall_ms / (every - 1));
+            for (size_t k = 0; k < v.size() && k < 40; ++k) {
+                fprintf(stderr, "op-prof: %6.2f%% %9.3f ms/eval %8.1f us/call %6.1f calls/eval  %s\n",
+                        100.0 * v[k].second.second / gpu_ms, v[k].second.second / every,
+                        1000.0 * v[k].second.second / v[k].second.first, (double) v[k].second.first / every, v[k].first.c_str());
+            }
+            acc.clear();
+            gpu_ms = wall_ms = 0.0;
+            evals = 0;
+        }
+    }
+};
+
+static ggml_cuda_op_prof & ggml_cuda_op_profiler() {
+    static ggml_cuda_op_prof p;
+    return p;
+}
+
 static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, const bool use_cuda_graph, const bool cuda_graph_update_required, const void * graph_key) {
     bool graph_evaluated_or_captured = false;
 
@@ -4297,8 +4402,16 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                 stream_ctx.concurrent_events.clear();
             }
 
+            ggml_cuda_op_prof & prof = ggml_cuda_op_profiler();
+            const bool profiling = prof.every > 0 && !(use_cuda_graph && cuda_graph_update_required);
+            if (profiling) {
+                prof.begin(cgraph->n_nodes);
+            }
             for (int i = 0; i < cgraph->n_nodes; i++) {
                 ggml_tensor * node = cgraph->nodes[i];
+                if (profiling) {
+                    prof.mark(i, node, cuda_ctx->stream(cuda_ctx->device, 0));
+                }
                 if (is_concurrent_event_active) {
                     GGML_ASSERT(concurrent_event);
 
@@ -4481,6 +4594,9 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                     try_launch_concurrent_event(node);
                }
             }
+            if (profiling) {
+                prof.end(cgraph->n_nodes, cuda_ctx->stream(cuda_ctx->device, 0));
+            }
         }
 
 #ifdef USE_CUDA_GRAPH
