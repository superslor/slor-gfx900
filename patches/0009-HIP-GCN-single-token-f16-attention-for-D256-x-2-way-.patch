--- /dev/null
+++ b/ggml/src/ggml-cuda/fattn-gcn.cu
@@ -0,0 +1,344 @@
+#include "fattn-gcn.cuh"
+
+#if !defined(GGML_USE_HIP)
+bool ggml_cuda_fattn_gcn_decode_try(ggml_backend_cuda_context &, ggml_tensor *) { return false; }
+#else
+#include "fattn-common.cuh"
+
+// single-token attention over an f16 cache on GCN, for Gemma 4 12B's shapes (global layers D512 with 16
+// query heads on 1 KV head, sliding-window layers D256 with 2 on each of 8). The tile kernel does these at 133 GB/s at
+// 20k: one token leaves it only the key dimension to spread over 56 CUs, and its 27 KB of shared memory per block lets
+// 2 blocks onto a CU. Here a block takes C keys of one KV head for all G of its query heads, flash-decoding style:
+//  - scores: a lane owns a key (or 256/C lanes share one) and streams its K row in 16-byte loads; the G query heads sit
+//    in shared memory (f16, pre-scaled) and come in as broadcasts; products in packed f16, folded into f32 every 32
+//    dims - no cross-lane sums;
+//  - softmax per head over the block's keys, weights written back to shared memory;
+//  - values: lanes own 8 dims of the V row, waves take the heads (or, with few heads, split the keys); weights come in
+//    as broadcasts; packed f16 products folded into f32 every 8 keys;
+//  - each block leaves an unnormalized partial output plus (max, sum) per head for flash_attn_combine_results.
+
+static constexpr int fattn_gcn_nthreads = 256;
+
+static __device__ __forceinline__ half2 fattn_gcn_h2(const uint32_t v) {
+    half2 h;
+    memcpy(&h, &v, sizeof(h));
+    return h;
+}
+
+template <int D, int G, int C>
+__launch_bounds__(fattn_gcn_nthreads, 2)
+static __global__ void fattn_gcn_decode(
+        const char * __restrict__ Q, const char * __restrict__ K, const char * __restrict__ V,
+        const half * __restrict__ mask, float * __restrict__ parts, float2 * __restrict__ meta,
+        const float scale, const float softcap, const int n_kv, const int nchunks,
+        const int64_t nbq2, const int64_t nbk1, const int64_t nbk2, const int64_t nbv1, const int64_t nbv2) {
+    constexpr int SPL = fattn_gcn_nthreads / C;       // lanes per key in the score pass
+    constexpr int DPL = D / SPL;                      // dims per lane there
+    constexpr int LPR = D / 8;                        // lanes per head-row in the value pass (8 dims each)
+    constexpr int NSL = fattn_gcn_nthreads / LPR;     // head-rows at a time
+    constexpr int HPS = G >= NSL ? G / NSL : 1;       // heads per slot
+    constexpr int KG  = G >= NSL ? 1 : NSL / G;       // key groups (few heads: slots split the keys)
+    constexpr int TPH = fattn_gcn_nthreads / G;       // threads per head in the softmax pass
+    static_assert(SPL >= 1 && DPL % 32 == 0, "bad C");
+    static_assert(HPS * NSL == G || KG * G == NSL, "bad G");
+
+    __shared__ half2  q_s[G][D / 2];                  // pre-scaled queries
+    __shared__ float  p_s[C][G];                      // scores, then weights
+    __shared__ float2 ml_s[G];                        // max, sum per head
+    __shared__ float  red_s[fattn_gcn_nthreads / 64][2];
+    __shared__ float  red_v[KG > 1 ? KG*G*D : 1];     // value-pass sums of the key groups (few heads only)
+
+    const int tid   = threadIdx.x;
+    const int chunk = blockIdx.x;
+    const int hkv   = blockIdx.y;
+    const int k0    = chunk * C;
+
+    // queries of this KV head's G heads, scaled, to f16
+    for (int i = tid; i < G * D / 2; i += fattn_gcn_nthreads) {
+        const int g = i / (D / 2);
+        const int d = i % (D / 2);
+        const float2 q = ((const float2 *) (Q + (int64_t) (hkv*G + g)*nbq2))[d];
+        q_s[g][d] = make_half2(q.x * scale, q.y * scale);
+    }
+    __syncthreads();
+
+    // scores: thread tid takes key k0 + tid/SPL, dims (tid%SPL)*DPL ..
+    {
+        const int kl   = tid / SPL;
+        const int part = tid % SPL;
+        const int key  = k0 + kl;
+        float acc[G];
+#pragma unroll
+        for (int g = 0; g < G; ++g) {
+            acc[g] = 0.0f;
+        }
+        if (key < n_kv) {
+            const uint4 * krow = (const uint4 *) (K + (int64_t) key*nbk1 + (int64_t) hkv*nbk2) + part*(DPL/8);
+#pragma unroll 2
+            for (int d32 = 0; d32 < DPL/32; ++d32) {
+                half2 a16[G];
+#pragma unroll
+                for (int g = 0; g < G; ++g) {
+                    a16[g] = make_half2(0.0f, 0.0f);
+                }
+#pragma unroll
+                for (int c = 0; c < 4; ++c) {           // 4 x 8 dims
+                    const uint4 kv = krow[d32*4 + c];
+                    const int   dq = (part*DPL + d32*32 + c*8) / 2;
+#pragma unroll
+                    for (int g = 0; g < G; ++g) {
+                        const uint4 qv = *(const uint4 *) &q_s[g][dq];
+                        a16[g] = __hfma2(fattn_gcn_h2(kv.x), fattn_gcn_h2(qv.x), a16[g]);
+                        a16[g] = __hfma2(fattn_gcn_h2(kv.y), fattn_gcn_h2(qv.y), a16[g]);
+                        a16[g] = __hfma2(fattn_gcn_h2(kv.z), fattn_gcn_h2(qv.z), a16[g]);
+                        a16[g] = __hfma2(fattn_gcn_h2(kv.w), fattn_gcn_h2(qv.w), a16[g]);
+                    }
+                }
+#pragma unroll
+                for (int g = 0; g < G; ++g) {
+                    const float2 f = __half22float2(a16[g]);
+                    acc[g] += f.x + f.y;
+                }
+            }
+        }
+#pragma unroll
+        for (int g = 0; g < G; ++g) {
+#pragma unroll
+            for (int o = SPL/2; o > 0; o >>= 1) {
+                acc[g] += __shfl_xor(acc[g], o, 64);
+            }
+        }
+        if (part == 0) {
+            const float mk = key < n_kv ? __half2float(mask[key]) : -INFINITY;
+#pragma unroll
+            for (int g = 0; g < G; ++g) {
+                float s = acc[g];
+                if (softcap != 0.0f) {
+                    s = softcap * tanhf(s);
+                }
+                p_s[kl][g] = key < n_kv ? s + mk : -INFINITY;
+            }
+        }
+    }
+    __syncthreads();
+
+    // softmax over the block's keys: TPH threads per head
+    {
+        const int g = tid / TPH;
+        const int j = tid % TPH;
+        float m = -INFINITY;
+        for (int k = j; k < C; k += TPH) {
+            m = fmaxf(m, p_s[k][g]);
+        }
+        if constexpr (TPH <= 64) {
+#pragma unroll
+            for (int o = TPH/2; o > 0; o >>= 1) {
+                m = fmaxf(m, __shfl_xor(m, o, 64));
+            }
+        } else {
+            m = warp_reduce_max<64>(m);
+            if (tid % 64 == 0) {
+                red_s[tid / 64][0] = m;
+            }
+            __syncthreads();
+            m = -INFINITY;
+            for (int w = g*(TPH/64); w < (g + 1)*(TPH/64); ++w) {
+                m = fmaxf(m, red_s[w][0]);
+            }
+        }
+        if (m == -INFINITY) {
+            m = -FLT_MAX / 2.0f;                      // all masked: weights 0, and the combine weighs it 0
+        }
+        float l = 0.0f;
+        for (int k = j; k < C; k += TPH) {
+            const float p = expf(p_s[k][g] - m);
+            p_s[k][g] = p;
+            l += p;
+        }
+        if constexpr (TPH <= 64) {
+#pragma unroll
+            for (int o = TPH/2; o > 0; o >>= 1) {
+                l += __shfl_xor(l, o, 64);
+            }
+        } else {
+            l = warp_reduce_sum<64>(l);
+            if (tid % 64 == 0) {
+                red_s[tid / 64][1] = l;
+            }
+            __syncthreads();
+            l = 0.0f;
+            for (int w = g*(TPH/64); w < (g + 1)*(TPH/64); ++w) {
+                l += red_s[w][1];
+            }
+        }
+        if (j == 0) {
+            ml_s[g] = make_float2(m, l);
+        }
+    }
+    __syncthreads();
+
+    // values: thread = (slot, 8 dims); a slot takes HPS heads, or with few heads 1 head and every KG-th key
+    {
+        const int slot  = tid / LPR;
+        const int dl    = tid % LPR;
+        const int gbase = G >= NSL ? slot*HPS : slot % G;
+        const int kg    = G >= NSL ? 0 : slot / G;
+
+        float acc[HPS][8];
+#pragma unroll
+        for (int h = 0; h < HPS; ++h) {
+#pragma unroll
+            for (int i = 0; i < 8; ++i) {
+                acc[h][i] = 0.0f;
+            }
+        }
+        const char * vbase = V + (int64_t) hkv*nbv2 + dl*16;
+        const int    kend  = min(C, n_kv - k0);
+        for (int kb = kg; kb < kend; kb += 8*KG) {
+            half2 a16[HPS][4];
+#pragma unroll
+            for (int h = 0; h < HPS; ++h) {
+#pragma unroll
+                for (int i = 0; i < 4; ++i) {
+                    a16[h][i] = make_half2(0.0f, 0.0f);
+                }
+            }
+#pragma unroll
+            for (int u = 0; u < 8; ++u) {
+                const int kl = kb + u*KG;
+                if (kl < kend) {
+                    const uint4 vv = *(const uint4 *) (vbase + (int64_t) (k0 + kl)*nbv1);
+#pragma unroll
+                    for (int h = 0; h < HPS; ++h) {
+                        const half2 p2 = __float2half2_rn(p_s[kl][gbase + h]);
+                        a16[h][0] = __hfma2(fattn_gcn_h2(vv.x), p2, a16[h][0]);
+                        a16[h][1] = __hfma2(fattn_gcn_h2(vv.y), p2, a16[h][1]);
+                        a16[h][2] = __hfma2(fattn_gcn_h2(vv.z), p2, a16[h][2]);
+                        a16[h][3] = __hfma2(fattn_gcn_h2(vv.w), p2, a16[h][3]);
+                    }
+                }
+            }
+#pragma unroll
+            for (int h = 0; h < HPS; ++h) {
+#pragma unroll
+                for (int i = 0; i < 4; ++i) {
+                    const float2 f = __half22float2(a16[h][i]);
+                    acc[h][2*i + 0] += f.x;
+                    acc[h][2*i + 1] += f.y;
+                }
+            }
+        }
+
+        if constexpr (KG > 1) {                       // sum the key groups of each head through shared memory
+#pragma unroll
+            for (int i = 0; i < 8; ++i) {
+                red_v[(kg*G + gbase)*D + dl*8 + i] = acc[0][i];
+            }
+            __syncthreads();
+            if (kg == 0) {
+                for (int k2 = 1; k2 < KG; ++k2) {
+#pragma unroll
+                    for (int i = 0; i < 8; ++i) {
+                        acc[0][i] += red_v[(k2*G + gbase)*D + dl*8 + i];
+                    }
+                }
+            }
+        }
+
+        if (kg == 0) {
+#pragma unroll
+            for (int h = 0; h < HPS; ++h) {
+                const int hq = hkv*G + gbase + h;
+                float4 * out = (float4 *) (parts + ((int64_t) hq*nchunks + chunk)*D + dl*8);
+                out[0] = make_float4(acc[h][0], acc[h][1], acc[h][2], acc[h][3]);
+                out[1] = make_float4(acc[h][4], acc[h][5], acc[h][6], acc[h][7]);
+                if (dl == 0) {
+                    meta[(int64_t) hq*nchunks + chunk] = ml_s[gbase + h];
+                }
+            }
+        }
+    }
+}
+
+template <int D, int G>
+static void fattn_gcn_decode_launch(ggml_backend_cuda_context & ctx, ggml_tensor * dst, const int C) {
+    const ggml_tensor * Q    = dst->src[0];
+    const ggml_tensor * K    = dst->src[1];
+    const ggml_tensor * V    = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+    cudaStream_t stream = ctx.stream();
+
+    float scale = 1.0f, softcap = 0.0f;
+    memcpy(&scale,   (const float *) dst->op_params + 0, sizeof(float));
+    memcpy(&softcap, (const float *) dst->op_params + 2, sizeof(float));
+    if (softcap != 0.0f) {
+        scale /= softcap;
+    }
+
+    const int n_kv    = K->ne[1];
+    const int hkv     = K->ne[2];
+    const int nchunks = (n_kv + C - 1) / C;
+    const int hq      = Q->ne[2];
+
+    ggml_cuda_pool_alloc<float>  parts(ctx.pool(), (size_t) hq*nchunks*D);
+    ggml_cuda_pool_alloc<float2> meta (ctx.pool(), (size_t) hq*nchunks);
+
+    const dim3 grid(nchunks, hkv, 1);
+#define FATTN_GCN_LAUNCH(C_)                                                                                            \
+    fattn_gcn_decode<D, G, C_><<<grid, fattn_gcn_nthreads, 0, stream>>>(                                                \
+        (const char *) Q->data, (const char *) K->data, (const char *) V->data, (const half *) mask->data,              \
+        parts.get(), meta.get(), scale, softcap, n_kv, nchunks, Q->nb[2], K->nb[1], K->nb[2], V->nb[1], V->nb[2])
+    if constexpr (G*D > 2048) {                       // 256 keys a block would leave these 1 block a CU (and spill)
+        if (C == 64) { FATTN_GCN_LAUNCH(64); } else { FATTN_GCN_LAUNCH(128); }
+    } else {
+        switch (C) {
+            case 64:  FATTN_GCN_LAUNCH(64);  break;
+            case 128: FATTN_GCN_LAUNCH(128); break;
+            default:  FATTN_GCN_LAUNCH(256); break;
+        }
+    }
+#undef FATTN_GCN_LAUNCH
+    CUDA_CHECK(cudaGetLastError());
+
+    // dst is [D, heads, 1 token, 1 sequence]: the combine's (col, head, sequence) grid with parallel_blocks = nchunks
+    flash_attn_combine_results<D><<<dim3(1, hq, 1), D, nchunks*sizeof(float2), stream>>>(
+        parts.get(), meta.get(), (float *) dst->data, nchunks);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+bool ggml_cuda_fattn_gcn_decode_try(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    static const bool enabled = [] { const char * e = getenv("GGML_CUDA_FA_GCN_DECODE"); return !e || atoi(e) != 0; }();
+    const ggml_tensor * Q    = dst->src[0];
+    const ggml_tensor * K    = dst->src[1];
+    const ggml_tensor * V    = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+    const ggml_tensor * sinks = dst->src[4];
+    if (!enabled || !GGML_CUDA_CC_IS_GCN(ggml_cuda_info().devices[ctx.device].cc)) {
+        return false;
+    }
+    float max_bias = 0.0f;
+    memcpy(&max_bias, (const float *) dst->op_params + 1, sizeof(float));
+    if (Q->type != GGML_TYPE_F32 || K->type != GGML_TYPE_F16 || V->type != GGML_TYPE_F16 || !mask || sinks ||
+        dst->type != GGML_TYPE_F32 || mask->ne[2] != 1 || mask->ne[3] != 1 ||
+        max_bias != 0.0f || Q->ne[1] != 1 || Q->ne[3] != 1 || K->ne[3] != 1 || mask->type != GGML_TYPE_F16 ||
+        K->ne[0] != V->ne[0] || K->ne[0] != Q->ne[0] || Q->ne[2] % K->ne[2] != 0 ||
+        K->nb[1] % 16 != 0 || V->nb[1] % 16 != 0 || K->nb[2] % 16 != 0 || V->nb[2] % 16 != 0 ||
+        ((uintptr_t) K->data) % 16 != 0 || ((uintptr_t) V->data) % 16 != 0 || mask->ne[0] < K->ne[1]) {
+        return false;
+    }
+    const int D = K->ne[0];
+    const int G = Q->ne[2] / K->ne[2];
+    GGML_UNUSED(V);
+    // Enough blocks for 56 CUs at 2 a CU: the most keys per block (fewer partials to combine) that still gives ~112.
+    // D512 x 16 heads stops at 128: queries (16 KB) + scores at 256 keys (16 KB) would leave 1 block a CU.
+    const int64_t nk = K->ne[1]*K->ne[2];
+    const int C = nk >= 256*112 ? 256 : nk >= 128*112 ? 128 : 64;
+    // (D512 x 16, Gemma's global layers: 541 vs the tile kernel's 311 us at 20k - per-lane K rows read at 74 GB/s,
+    // every wave re-reading V, and a 160-part combine - so those stay on the tile kernel.)
+    if (D == 256 && G == 2) {
+        fattn_gcn_decode_launch<256, 2>(ctx, dst, C);
+        return true;
+    }
+    return false;
+}
+#endif // !defined(GGML_USE_HIP)
