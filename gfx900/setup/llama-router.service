[Unit]
Description=llama-server in router mode (MI25)
Wants=network-online.target gpu-setup.service
After=network-online.target systemd-modules-load.service gpu-setup.service

[Service]
DynamicUser=yes
SupplementaryGroups=video render
Environment=LD_LIBRARY_PATH=/opt/llama-gfx900/bin:/opt/rocblas-gfx900/lib
Environment=ROCBLAS_TENSILE_LIBPATH=/opt/rocblas-gfx900/library
Environment=LLAMA_SPEC_SAMPLE_TEMP=1.0
Environment=LLAMA_SPEC_DRAFT_TOPK=20
ExecStart=/opt/llama-gfx900/bin/llama-server --models-preset /etc/llama/models.ini --models-max 1 \
  --host 127.0.0.1 --port 8090
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
